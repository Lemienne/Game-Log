<!DOCTYPE html>
<html lang="ko">
  <%- include("partials/head") %>
  <body class="<%= showNavigation ? 'has-navigation' : '' %>">
    <%- include("partials/header") %>
    <main class="page-content<%= currentSection?.path === "/" ? " home-content" : "" %>">
      <% if (currentSection?.path === "/") { %>
        <%- include("partials/home") %>
      <% } else { %>
        <h1><%= title %></h1>
      <% } %>
    </main>
    <%- include("partials/foot") %>
  </body>
</html>
