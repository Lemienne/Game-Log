<h1><%= title %></h1>
<nav class="library-segments" aria-label="게임 목록" data-library-tabs>
  <% for (const option of tabs) { %>
    <a href="<%= option.href %>" data-library-tab="<%= option.key %>" <% if (option.key === tab) { %>class="library-segment-current" aria-current="page"<% } %>><%= option.label %></a>
  <% } %>
</nav>
<div class="library-list-header">
  <span>게임 <%= games.length %>개</span>
  <details class="library-sort">
    <summary>
      <%= selectedSort ? selectedSort.label + " " + selectedSort.arrow : "최근 추가순" %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
        <path d="m4 9 8 8 8-8"/>
      </svg>
    </summary>
    <ul class="library-sort-options" aria-label="정렬 방식">
      <% for (const option of sortOptions) { %>
        <li><a href="<%= option.href %>" <% if (option.key === sort.key) { %>aria-current="true"<% } %>>
          <%= option.label %> <span aria-hidden="true"><%= option.arrow %></span>
          <span class="visually-hidden"><%= option.arrow === "↑" ? "오름차순" : "내림차순" %></span>
        </a></li>
      <% } %>
    </ul>
  </details>
</div>
<ul class="library-game-list">
  <% for (const number of games) { %>
    <li>
      <a class="library-game-row" href="/library/games/<%= number %>?<%= detailQuery %>">
        <span class="poster-placeholder library-poster">게임 포스터 <%= number %></span>
        <span>
          게임 타이틀 <%= number %>
          <small>게임 플랫폼 <%= number %><span data-owned-only <%= tab === "wishlist" ? "hidden" : "" %>> · <%= number === 2 ? "아직 플레이하지 않음" : "플레이 시간 " + number %></span></small>
        </span>
        <span class="library-row-more" aria-hidden="true">•••</span>
      </a>
    </li>
  <% } %>
</ul>
<% if (showRevisit) { %>
  <section class="library-section" aria-labelledby="revisit-heading">
    <h2 id="revisit-heading">
      <span data-owned-only <%= tab === "wishlist" ? "hidden" : "" %>>다시 만나고 싶은 게임</span>
      <span data-wishlist-only <%= tab === "owned" ? "hidden" : "" %>>곧 출시되는 게임</span>
    </h2>
    <%- include("cards", { listClass: "home-rail library-revisit", headingId: "revisit-heading" }) %>
  </section>
<% } %>
<script src="/javascripts/library-tabs.js" defer></script>
